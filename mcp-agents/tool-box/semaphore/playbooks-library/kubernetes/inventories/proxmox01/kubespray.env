# Read by kubespray/kubespray.sh. The cluster was built with this version; keep it pinned and bump it
# deliberately (each kubespray release supports a narrow range of kube_version and ansible-core).
KUBESPRAY_VERSION=v2.23.0
ANSIBLE_USER=vishwas
# kubespray v2.23.0 templates its asserts ("groups.get('{{ item }}')"). ansible-core >= 2.14.12 rejects
# that (CVE-2023-5764: "Conditional is marked as unsafe"), and ansible==7.6.0 now resolves to 2.14.18.
# Hold the last release before the change. Remove when kubespray is bumped to a release that fixed it.
ANSIBLE_CORE_VERSION=2.14.11
